{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["benches/gmd/*.js", "benches/*/versions/**"],
  "plugins": ["oxc", "typescript", "unicorn", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {},
  "env": {
    "node": true,
    "es2024": true
  }
}
